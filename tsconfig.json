{
  "compilerOptions": {
    "module": "NodeNext", // เปลี่ยนจาก NodeNext
    "moduleResolution": "NodeNext", // เปลี่ยนจาก NodeNext
    "esModuleInterop": true,
    "isolatedModules": false, // เปลี่ยนเป็น false (NodeNext บังคับ true ซึ่งขัดกับ emitDecoratorMetadata)
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "types": [
      "jest",
      "node",
      "multer"
    ]
  }
}